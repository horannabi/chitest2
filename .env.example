# 복사해서 .env 로 쓰세요. (.env 는 .gitignore 에 들어 있어 커밋되지 않습니다)

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 찾을 영화 키워드 (쉼표로 여러 개). 제목에 하나라도 들어 있으면 일치
KEYWORDS=치이카와

# --- 아래는 처음 실행할 때만 쓰이는 기본값입니다. 이후에는 텔레그램 명령이 우선입니다. ---
# 감시 지점 (이름 또는 번호, 쉼표로). 이후에는 /add /remove 로 바꿉니다.
SITES=강남,강변
# 이 시각 이전에 시작하는 회차만. off 면 하루 전체. 이후에는 /morning 으로 바꿉니다.
MORNING_END=12:00
# 감시 날짜. 비워 두면 텔레그램 /watch 로 지정
TARGET_DATE=

# --- 조회기 ---
# curl(기본, curl_cffi: 가볍고 빠름) | browser(진짜 크롬. 무겁지만 curl 이 막힐 때의 대안)
FETCHER=curl
# browser 일 때만: 헤드리스가 막히면 0 으로 해서 창을 띄운다
HEADLESS=1
# 설치된 구글 크롬을 쓰려면 chrome
CHROME_CHANNEL=

# --- 주기 ---
POLL_SEC=30
BURST_SEC=10
# 예: 09:50-10:20 (이 구간에서는 BURST_SEC 간격으로 조회). KST
BURST_WINDOWS=
SITE_GAP_SEC=0.7
ALERT_REPEAT_SEC=30
